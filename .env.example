# ============================================================
#  GSsmart Desktop - Configuracion de proveedores
#  Copia este archivo como .env y completa con tus claves
# ============================================================

# ------------------------------------------------------------
# PROVEEDOR OFICIAL 1: OpenRouter (gratis + de pago)
# Sacas tu key aca: https://openrouter.ai/keys
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# ------------------------------------------------------------
# PROVEEDOR OFICIAL 2: OpenAI
# Sacas tu key aca: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-tu-clave-aqui
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# PROVEEDOR PERSONALIZADO (cualquier API compatible con OpenAI)
# Ejemplos: LM Studio local (http://localhost:1234/v1),
# Ollama (http://localhost:11434/v1), vLLM, Groq, Mistral,
# cualquier endpoint propio.
# ------------------------------------------------------------
CUSTOM_API_KEY=no-necesaria-para-local
CUSTOM_BASE_URL=http://localhost:1234/v1
CUSTOM_MODEL=local-model

# ------------------------------------------------------------
# MOTORES DE VIDEO (src/media) - van aparte de los providers de chat.
# Ver src/media/base_video_provider.py para el porque de la separacion.
# ------------------------------------------------------------

# JSON2Video: REST con API key. Plan Free da ~590 unidades de quota.
#   seedance-v1.5-pro = 20 credits/seg, text-to-video
#   wan-v2.5          = 30 credits/seg, image-to-video
JSON2VIDEO_API_KEY=tu-clave-de-json2video
JSON2VIDEO_MODEL=seedance-v1.5-pro

# Wan2.2 via Space de HuggingFace / ZeroGPU: sin key y sin costo, pero con
# cola compartida y depende de que el Space este en linea (a veces no lo esta).
WAN_SPACE=zerogpu-aoti/wan2-2-fp8da-aoti-faster

# BytePlus ModelArk / Seedance. Factura por TOKENS (no por creditos ni por
# segundo). Da 500.000 tokens gratis por modelo.
# OJO: el par AK/SK de IAM NO sirve aca. La API de Ark usa Bearer.
# Key en: https://ai.byteplus.com/ark/region:ap-southeast-1/apikey
# La region debe ser ap-southeast-1 (Johor) o no aparecen los modelos.
ARK_API_KEY=tu-ark-api-key
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL=seedance-1-0-pro-250528